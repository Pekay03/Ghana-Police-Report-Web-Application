<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!-- Production credentials are provisioned separately by the hosting operator.
       The private local credential file must never be published. -->
  <connectionStrings configSource="Web.Production.config"
                     xdt:Transform="SetAttributes(configSource)" />
  <appSettings>
    <add key="EnableLocalAssessmentRoleSignup" value="false"
         xdt:Locator="Match(key)" xdt:Transform="SetAttributes(value)" />
  </appSettings>
  <system.web>
    <compilation debug="false" xdt:Transform="SetAttributes(debug)" />
  </system.web>
</configuration>